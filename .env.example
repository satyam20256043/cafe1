# ☕ Zordic California — Environment Configuration
# Copy to .env and fill in real values. Never commit .env (it's gitignored).

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3010
# Public URL of the deployed server (used to build links in WhatsApp messages, etc.)
BASE_URL=http://localhost:3010

# ── Google Gemini API Key (Required for natural human-like AI responses) ─────
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenAI GPT (optional — not wired into the default reply routing yet) ─────
# Get a key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
GPT_MODEL=gpt-5.5

# ── JWT Authentication Secret ─────────────────────────────────────────────────
# REQUIRED. Must be >=32 chars and NOT a known default — the server refuses to
# boot otherwise (Phase 0 safeguard). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES=8h

# ── Razorpay Payment Gateway (optional — leave blank for cash-only launch) ────
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you set in Razorpay Dashboard → Webhooks. REQUIRED for automatic
# plan activation: without it the webhook refuses every request (fails closed).
RAZORPAY_WEBHOOK_SECRET=

# ── Operator alerts (optional) ────────────────────────────────────────────────
# Your own phone, and the id of a café whose WhatsApp is reliably connected —
# platform alerts (a café's WhatsApp dropping, AI key failures) are sent from it.
# The welcome message to every new sign-up is also sent from that café's WhatsApp
# (no welcome is sent while OPERATOR_ALERT_BRANCH_ID is unset).
# OPERATOR_ALERT_PHONE=
# OPERATOR_ALERT_BRANCH_ID=

# ── Web Push notifications (optional) ─────────────────────────────────────────
# Generate a VAPID key pair: npx web-push generate-vapid-keys
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_EMAIL=mailto:admin@example.com

# ── WhatsApp Cloud API webhook (required to enable WhatsApp) ─────────────────
# Any random string you choose — must match the "Verify token" you enter in the
# Meta App Dashboard's WhatsApp > Configuration > Webhook setup.
WHATSAPP_VERIFY_TOKEN=

# ── WhatsApp QR linking ───────────────────────────────────────────────────────
# Max cafés linked by QR scan on this server (each runs a headless browser,
# ~200 MB RAM). Default 10 suits a 4 GB server; use 1–2 on a 512 MB box.
# WA_QR_MAX_CLIENTS=10

# ── Google Business Profile integration (Phase A) ─────────────────────────────
# Set GOOGLE_MODE=mock to use demo data without a real Google connection (safe
# for local dev). Set to 'live' for production after Google approves API access.
# Never copy local keys to production — generate a separate set per environment.
#
# GOOGLE_MODE=mock
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://zordical.com/api/google/oauth/callback
#
# TOKEN_ENCRYPTION_KEY: 64 hex chars (32 bytes). Required for live mode.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TOKEN_ENCRYPTION_KEY=
